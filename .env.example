# Copy to .env. Default backend is the offline simulator.
JEV_BACKEND=sim            # sim | http | replay
TYPESAFE_API_KEY=          # required for JEV_BACKEND=http (console.typesafe.ai/keys)
JEV_SIM_SLEEP=0            # 1 = simulator really sleeps its modelled latency
JEV_FALLBACK=              # "escalate" = kill switch: every action escalates
